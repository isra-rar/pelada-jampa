PELADA_ENVIRONMENT=development
PELADA_DATABASE_URL=postgresql+psycopg://pelada:pelada@localhost:5432/pelada
PELADA_JWT_SECRET=troque-este-segredo
PELADA_ACCESS_TOKEN_EXPIRE_MINUTES=1440
PELADA_SCHEDULER_ENABLED=true
PELADA_SCHEDULER_INTERVAL_SECONDS=60
PELADA_DRAW_TIME_LIMIT_SECONDS=2.0
PELADA_CORS_ORIGINS=["http://localhost:4200"]

# URL do frontend (links de redefinição de senha) e base pública da API (fotos enviadas)
PELADA_FRONTEND_URL=http://localhost:8080
# PELADA_PUBLIC_BASE_URL=https://api.suapelada.com.br

# E-mail (sem SMTP, os e-mails aparecem no log do servidor)
# PELADA_SMTP_HOST=smtp.exemplo.com
# PELADA_SMTP_PORT=587
# PELADA_SMTP_USER=
# PELADA_SMTP_PASSWORD=
# PELADA_SMTP_FROM=Pelada+ <nao-responda@suapelada.com.br>

# Uploads
PELADA_MEDIA_DIR=./media

# Web Push (gere com: python scripts/generate_vapid_keys.py)
# PELADA_VAPID_PUBLIC_KEY=
# PELADA_VAPID_PRIVATE_KEY=
# PELADA_VAPID_SUBJECT=mailto:admin@suapelada.com.br

# Login com Google: Client ID do tipo "Aplicativo da Web" (Google Cloud Console > APIs e serviços > Credenciais).
# Em "Origens JavaScript autorizadas" cadastre a URL do frontend (ex.: http://localhost:8080 e o domínio de produção).
# PELADA_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
